{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build main.cpp",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/main.cpp",
                "-o",
                "${workspaceFolder}/main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compiles main.cpp with warnings on. Requires g++ on PATH (MinGW-w64)."
        }
    ]
}
